{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kuro-lab",
  "main": "./worker.js",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "KURO_MIGRATION_DB",
      "database_name": "kuro-migration-copy",
      "database_id": "40a4610e-548c-4e02-b7b0-53c25d0de8c0"
    },
    {
      "binding": "KURO_APP_DB",
      "database_name": "kuro-app-data-mirror",
      "database_id": "7ed0a9f4-da8b-4e67-b4b5-66480accf080"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "KURO_MIGRATION_DB",
        "database_id": "40a4610e-548c-4e02-b7b0-53c25d0de8c0"
      },
      {
        "binding": "KURO_APP_DB",
        "database_id": "40a4610e-548c-4e02-b7b0-53c25d0de8c0"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "issues": {
      "enabled": true
    },
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
