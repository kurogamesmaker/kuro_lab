{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kuro-lab",
  "main": "./worker.js",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "issues": {
      "enabled": true
    },
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
